From 320663d0386b8604f1e4f874b1c630f9fd13637a Mon Sep 17 00:00:00 2001
From: Dhruv Rakeshbhai Patel <dpatel5469@gmail.com>
Date: Mon, 9 Nov 2026 12:37:19 +0000
Subject: [PATCH 1/2] r8169: select DIMLIB and add adaptive RX moderation state

Prepare r8169 for adaptive receive interrupt moderation based on the
generic DIM library. Select DIMLIB from the R8169 Kconfig entry and add
the per-device state the later patches need: a struct dim, a flag for
the ethtool adaptive-rx setting, and driver-owned RX packet and byte
counters. The existing RX statistics are per-CPU and awkward to sample
from the poll function, so DIM gets its own counters, to be updated
from NAPI context only.

Nothing uses the new members yet, so there is no functional change.

Co-authored-by: Claude <noreply@anthropic.com>
---
 drivers/net/ethernet/realtek/Kconfig      | 1 +
 drivers/net/ethernet/realtek/r8169_main.c | 7 +++++++
 2 files changed, 8 insertions(+)

diff --git a/drivers/net/ethernet/realtek/Kconfig b/drivers/net/ethernet/realtek/Kconfig
index 9b0f4f9..a2c6a2e 100644
--- a/drivers/net/ethernet/realtek/Kconfig
+++ b/drivers/net/ethernet/realtek/Kconfig
@@ -88,6 +88,7 @@ config R8169
 	select CRC32
 	select PHYLIB
 	select REALTEK_PHY
+	select DIMLIB
 	help
 	  Say Y here if you have a Realtek Ethernet adapter belonging to
 	  the following families:
diff --git a/drivers/net/ethernet/realtek/r8169_main.c b/drivers/net/ethernet/realtek/r8169_main.c
index ee1bc9b..40b6d4e 100644
--- a/drivers/net/ethernet/realtek/r8169_main.c
+++ b/drivers/net/ethernet/realtek/r8169_main.c
@@ -29,6 +29,7 @@
 #include <linux/prefetch.h>
 #include <linux/ipv6.h>
 #include <linux/unaligned.h>
+#include <linux/dim.h>
 #include <net/ip6_checksum.h>
 #include <net/netdev_queues.h>
 #include <net/phy/realtek_phy.h>
@@ -774,6 +775,12 @@ struct rtl8169_private {
 	struct r8169_led_classdev *leds;
 
 	u32 ocp_base;
+
+	/* Adaptive RX interrupt moderation (DIM) */
+	struct dim rx_dim;
+	bool rx_dim_enabled;	/* ethtool adaptive-rx, changed under RTNL */
+	u64 rx_dim_packets;	/* updated from NAPI context only */
+	u64 rx_dim_bytes;	/* updated from NAPI context only */
 };
 
 typedef void (*rtl_generic_fct)(struct rtl8169_private *tp);
